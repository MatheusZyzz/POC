<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Amazing Manager — AI Reports (POC)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#142860; --navy-700:#1C3470; --navy-600:#24407F;
    --cyan:#19D3C7; --blue:#3363FF; --green:#16A34A; --coral:#EF5A3C; --red:#DC2626;
    --page:#F3F4F6; --card:#FFFFFF; --border:#E6EAF1; --field:#F1F5F9;
    --text:#1E293B; --strong:#142860; --muted:#64748B; --faint:#94A3B8;
    --grad:linear-gradient(120deg,#19D6C8 0%,#3363FF 100%);
    --grad-bar:linear-gradient(90deg,#22C9E0 0%,#3363FF 100%);
    --radius:12px; --radius-sm:9px;
    --display:'Poppins',-apple-system,'Segoe UI',Roboto,sans-serif;
    --body:'Inter',-apple-system,'Segoe UI',Roboto,sans-serif;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{font-family:var(--body);color:var(--text);background:var(--page);font-size:14px;-webkit-font-smoothing:antialiased}
  .app{display:flex;height:100vh;overflow:hidden}

  /* ---------- Sidebar ---------- */
  .side{width:248px;flex-shrink:0;background:var(--navy);color:#fff;display:flex;flex-direction:column;padding:16px 14px}
  .brand{display:flex;align-items:center;gap:10px;padding:6px 6px 14px}
  .brand .mark{width:38px;height:38px;border-radius:11px;background:var(--grad);display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .brand .mark svg{width:20px;height:20px;color:#fff}
  .brand .name{line-height:1.05;font-family:var(--display)}
  .brand .name b{display:block;font-weight:600;font-size:15px;color:#fff}
  .brand .name span{display:block;font-weight:400;font-size:13px;color:var(--cyan)}
  .selector{display:flex;align-items:center;gap:9px;background:var(--navy-700);border:1px solid rgba(255,255,255,.06);border-radius:var(--radius-sm);padding:9px 11px;margin-top:8px;cursor:pointer;color:#dfe6f5;font-size:13px}
  .selector svg{width:16px;height:16px;flex-shrink:0;opacity:.85}
  .selector .lbl{flex:1;font-weight:500;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .selector .chev{width:15px;height:15px;opacity:.7}
  .divide{height:1px;background:rgba(255,255,255,.10);margin:16px 4px 14px}
  .newbtn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;border:0;border-radius:var(--radius-sm);background:var(--grad);color:#fff;font-family:var(--body);font-weight:600;font-size:13.5px;padding:11px;cursor:pointer;box-shadow:0 6px 16px rgba(51,99,255,.30)}
  .newbtn svg{width:17px;height:17px}
  .eyebrow{font-size:11px;letter-spacing:.10em;text-transform:uppercase;color:#7f8db0;font-weight:600;padding:18px 6px 8px}
  .recent{display:flex;flex-direction:column;gap:3px;overflow-y:auto}
  .ritem{display:flex;gap:10px;align-items:flex-start;padding:9px 10px;border-radius:var(--radius-sm);border-left:3px solid transparent;cursor:pointer;color:#cfd8ec;transition:background .15s}
  .ritem:hover{background:rgba(255,255,255,.05)}
  .ritem.active{background:rgba(255,255,255,.08);border-left-color:var(--cyan)}
  .ritem .ic{width:16px;height:16px;margin-top:1px;flex-shrink:0;opacity:.85}
  .ritem .tt{min-width:0}
  .ritem .tt b{display:block;font-weight:500;font-size:13px;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ritem .tt span{font-size:11.5px;color:#8492b5}

  /* ---------- Main ---------- */
  .main{flex:1;display:flex;flex-direction:column;min-width:0}
  .topbar{height:62px;flex-shrink:0;background:#fff;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:16px;padding:0 22px}
  .gsearch{flex:1;max-width:640px;display:flex;align-items:center;gap:10px;background:var(--field);border-radius:10px;padding:9px 14px;color:var(--faint)}
  .gsearch svg{width:18px;height:18px}
  .gsearch input{border:0;background:transparent;outline:none;flex:1;font-family:var(--body);font-size:13.5px;color:var(--text)}
  .topicons{display:flex;align-items:center;gap:6px;margin-left:auto}
  .iconbtn{width:38px;height:38px;border-radius:10px;border:0;background:transparent;color:var(--blue);display:flex;align-items:center;justify-content:center;cursor:pointer}
  .iconbtn:hover{background:var(--field)}
  .iconbtn svg{width:19px;height:19px}
  .userpill{display:flex;align-items:center;gap:9px;padding:5px 10px 5px 6px;border-radius:24px;border:1px solid var(--border);cursor:pointer;margin-left:6px}
  .userpill .av{width:30px;height:30px;border-radius:50%;background:var(--grad);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:13px}
  .userpill b{font-weight:500;font-size:13.5px;color:var(--strong)}
  .userpill svg{width:15px;height:15px;color:var(--muted)}

  .scroll{flex:1;overflow-y:auto;padding:28px 30px 40px}

  /* ---------- Home / empty state ---------- */
  .home{max-width:680px;margin:6vh auto 0;text-align:center}
  .home .spark{width:54px;height:54px;border-radius:16px;background:var(--grad);display:inline-flex;align-items:center;justify-content:center;margin-bottom:18px;box-shadow:0 10px 26px rgba(51,99,255,.25)}
  .home .spark svg{width:26px;height:26px;color:#fff}
  .home h1{font-family:var(--display);font-weight:600;font-size:27px;color:var(--strong);margin:0 0 8px}
  .home p.sub{font-size:15px;color:var(--muted);margin:0 0 26px;line-height:1.5}
  .prompt{display:flex;align-items:center;gap:10px;background:#fff;border:1.5px solid var(--border);border-radius:16px;padding:8px 8px 8px 16px;box-shadow:0 8px 30px rgba(20,40,96,.07);transition:border-color .15s,box-shadow .15s}
  .prompt:focus-within{border-color:var(--blue);box-shadow:0 8px 30px rgba(51,99,255,.16)}
  .prompt .si{width:19px;height:19px;color:var(--faint);flex-shrink:0}
  .prompt input{flex:1;border:0;outline:none;background:transparent;font-family:var(--body);font-size:15px;color:var(--text);padding:8px 0}
  .gobtn{width:40px;height:40px;border-radius:12px;border:0;background:var(--grad);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0}
  .gobtn:hover{filter:brightness(1.05)}
  .gobtn svg{width:20px;height:20px}
  .hint{font-size:12.5px;color:var(--coral);margin:10px 2px 0;min-height:16px;text-align:left;opacity:0;transition:opacity .2s}
  .hint.show{opacity:1}
  .chips{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:20px}
  .chip{display:flex;align-items:center;gap:8px;border:1px solid var(--border);background:#fff;border-radius:11px;padding:9px 14px;font-size:13px;font-weight:500;color:var(--strong);cursor:pointer;transition:all .15s}
  .chip:hover{border-color:var(--blue);background:#F7F9FF;transform:translateY(-1px)}
  .chip svg{width:16px;height:16px;color:var(--blue)}
  .examples{margin-top:30px;text-align:left;border-top:1px solid var(--border);padding-top:18px}
  .examples .lab{font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--faint);font-weight:600;margin-bottom:10px}
  .ex{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:10px;color:var(--muted);font-size:13.5px;cursor:pointer}
  .ex:hover{background:#F7F9FF;color:var(--strong)}
  .ex svg{width:15px;height:15px;color:var(--faint)}

  /* ---------- Loading ---------- */
  .loading{max-width:680px;margin:18vh auto 0;display:flex;flex-direction:column;align-items:center;gap:16px}
  .loading .ring{width:46px;height:46px;border-radius:50%;border:3px solid var(--border);border-top-color:var(--blue);animation:spin .8s linear infinite}
  .loading .lt{font-family:var(--display);font-weight:500;color:var(--strong);font-size:16px}
  .loading .ls{color:var(--muted);font-size:13.5px}
  @keyframes spin{to{transform:rotate(360deg)}}

  /* ---------- Report ---------- */
  .report{max-width:1080px;margin:0 auto;animation:fadeUp .35s ease}
  @keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  .rhead{display:flex;align-items:flex-start;gap:16px;margin-bottom:18px;flex-wrap:wrap}
  .rhead .ht{flex:1;min-width:240px}
  .rhead h2{font-family:var(--display);font-weight:600;font-size:23px;color:var(--strong);margin:0 0 5px}
  .rhead .meta{display:flex;align-items:center;gap:14px;flex-wrap:wrap;color:var(--muted);font-size:13px}
  .rhead .meta .ai{display:inline-flex;align-items:center;gap:5px;color:var(--blue);font-weight:500}
  .rhead .meta .ai svg{width:14px;height:14px}
  .rhead .meta .dot{width:3px;height:3px;border-radius:50%;background:var(--faint)}
  .ractions{display:flex;gap:9px}
  .btn{display:inline-flex;align-items:center;gap:7px;border-radius:10px;font-family:var(--body);font-weight:500;font-size:13px;padding:9px 14px;cursor:pointer;border:1px solid var(--border);background:#fff;color:var(--strong)}
  .btn:hover{background:var(--field)}
  .btn svg{width:16px;height:16px}
  .btn.primary{border:0;background:var(--grad);color:#fff;box-shadow:0 6px 16px rgba(51,99,255,.25)}
  .btn.primary:hover{filter:brightness(1.05)}

  .ai-card{display:flex;gap:14px;background:linear-gradient(120deg,#F4FBFA,#F4F7FF);border:1px solid #DCE9FB;border-left:4px solid var(--cyan);border-radius:var(--radius);padding:16px 18px;margin-bottom:20px}
  .ai-card .badge{display:inline-flex;align-items:center;gap:6px;background:var(--grad);color:#fff;font-size:11px;font-weight:600;padding:4px 10px;border-radius:20px;height:fit-content;white-space:nowrap}
  .ai-card .badge svg{width:13px;height:13px}
  .ai-card p{margin:0;font-size:14px;line-height:1.62;color:#2a3a5c}

  .metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}
  .metric{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:15px 16px}
  .metric .ml{font-size:12.5px;color:var(--muted);font-weight:500;margin-bottom:7px}
  .metric .mv{font-family:var(--display);font-weight:600;font-size:25px;line-height:1;letter-spacing:-.01em}
  .metric .ms{font-size:12px;color:var(--muted);margin-top:8px;display:flex;align-items:center;gap:4px}
  .metric .ms svg{width:13px;height:13px}
  .mv.green{color:var(--green)} .mv.coral{color:var(--coral)} .mv.blue{color:var(--blue)} .mv.navy{color:var(--strong)}
  .up{color:var(--green)} .down{color:var(--coral)}

  .grid2{display:grid;grid-template-columns:1.05fr 1fr;gap:18px;margin-bottom:20px}
  .panel{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:18px}
  .panel h3{font-family:var(--display);font-weight:500;font-size:15px;color:var(--strong);margin:0 0 4px}
  .panel .psub{font-size:12.5px;color:var(--muted);margin:0 0 14px}
  .donut-wrap{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
  .donut-svg{width:150px;height:150px;flex-shrink:0}
  .donut-svg .dn{fill:var(--strong);font-family:var(--display);font-weight:600;font-size:26px}
  .donut-svg .dl{fill:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.08em}
  .legend{display:flex;flex-direction:column;gap:10px;flex:1;min-width:140px}
  .legend .li{display:flex;align-items:center;gap:9px;font-size:13px}
  .legend .sw{width:11px;height:11px;border-radius:3px;flex-shrink:0}
  .legend .ln{color:var(--text);flex:1}
  .legend .lv{font-weight:600;color:var(--strong)}
  .chart-svg{width:100%;height:auto;display:block}
  .chart-svg .cv{fill:var(--strong);font-size:13px;font-weight:500;font-family:var(--body)}
  .chart-svg .cx{fill:var(--muted);font-size:12px;font-family:var(--body)}

  .hbars{display:flex;flex-direction:column;gap:13px}
  .hbar{display:grid;grid-template-columns:130px 1fr 40px;align-items:center;gap:12px}
  .hbar .hl{font-size:13px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .hbar .ht{height:9px;background:var(--field);border-radius:6px;overflow:hidden}
  .hbar .hf{height:100%;border-radius:6px;background:var(--grad-bar)}
  .hbar .hv{font-size:12.5px;font-weight:600;color:var(--strong);text-align:right}

  .tbl-panel{background:#fff;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}
  .tbl-head{display:flex;align-items:center;justify-content:space-between;padding:16px 18px 14px}
  .tbl-head h3{font-family:var(--display);font-weight:500;font-size:15px;color:var(--strong);margin:0}
  .tbl-head a{font-size:12.5px;color:var(--blue);font-weight:500;cursor:pointer;display:inline-flex;align-items:center;gap:4px}
  .tbl-head a svg{width:14px;height:14px}
  table{width:100%;border-collapse:collapse}
  thead th{background:#F6F8FC;text-align:left;font-size:11px;letter-spacing:.04em;text-transform:uppercase;color:#5b6b8c;font-weight:600;padding:10px 18px}
  tbody td{padding:12px 18px;font-size:13px;border-top:1px solid var(--border);color:var(--text);white-space:nowrap}
  tbody tr:hover{background:#FAFBFE}
  td.num{text-align:right;font-variant-numeric:tabular-nums;font-weight:500}
  td.strong{font-weight:500;color:var(--strong)}
  .badge2{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:500;padding:3px 9px;border-radius:20px}
  .badge2::before{content:"";width:6px;height:6px;border-radius:50%}
  .b-ok{background:#EAF8F0;color:#15803D}.b-ok::before{background:var(--green)}
  .b-warn{background:#FEF1EC;color:#C2410C}.b-warn::before{background:var(--coral)}
  .b-pend{background:#EEF3FF;color:#1E40AF}.b-pend::before{background:var(--blue)}
  .b-mut{background:#F1F5F9;color:#475569}.b-mut::before{background:var(--faint)}

  .insights{margin-top:20px;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:18px}
  .insights h3{font-family:var(--display);font-weight:500;font-size:15px;color:var(--strong);margin:0 0 14px;display:flex;align-items:center;gap:8px}
  .insights h3 svg{width:17px;height:17px;color:var(--blue)}
  .insights ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:11px}
  .insights li{display:flex;gap:11px;font-size:13.5px;line-height:1.5;color:var(--text)}
  .insights li svg{width:16px;height:16px;color:var(--green);flex-shrink:0;margin-top:1px}

  @media (max-width:920px){
    .metrics{grid-template-columns:repeat(2,1fr)}
    .grid2{grid-template-columns:1fr}
    .side{width:210px}
  }
  @media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
  :focus-visible{outline:2px solid var(--blue);outline-offset:2px}

  @media print{
    .side,.topbar,.ractions,.tbl-head a{display:none!important}
    .scroll{overflow:visible;padding:0}
    body{background:#fff}
    .report{max-width:none}
    .panel,.metric,.tbl-panel,.insights,.ai-card{break-inside:avoid}
  }
</style>
</head>
<body>
<div class="app">
  <!-- Sidebar -->
  <aside class="side">
    <div class="brand">
      <div class="mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none"><path d="M8 5l10 7-10 7V5z" fill="currentColor"/></svg>
      </div>
      <div class="name"><b>amazing</b><span>manager</span></div>
    </div>

    <div class="selector"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6M9 13h6"/></svg><span class="lbl">Income Tax Plus Inc</span><svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></div>
    <div class="selector"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h18v12H3z"/><path d="M8 7V5h8v2"/></svg><span class="lbl">Framingham</span><svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></div>

    <div class="divide"></div>

    <button class="newbtn" id="newBtn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>New report</button>

    <div class="eyebrow">Recent</div>
    <div class="recent" id="recent"></div>
  </aside>

  <!-- Main -->
  <div class="main">
    <header class="topbar">
      <div class="gsearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input placeholder="Search clients, ID, SO, email..." aria-label="Global search"></div>
      <div class="topicons">
        <button class="iconbtn" aria-label="Calendar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></button>
        <button class="iconbtn" aria-label="Notifications"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></button>
        <button class="iconbtn" aria-label="Settings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-2.7 1.1V21a2 2 0 0 1-4 0v-.1A1.6 1.6 0 0 0 7 19.4a1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0-1.1-2.7H1a2 2 0 0 1 0-4h.1A1.6 1.6 0 0 0 2.6 7a1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1A1.6 1.6 0 0 0 7 2.6h.1A1.6 1.6 0 0 0 9 1.1V1a2 2 0 0 1 4 0v.1A1.6 1.6 0 0 0 17 2.6a1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8v.1A1.6 1.6 0 0 0 22.9 9H23a2 2 0 0 1 0 4h-.1a1.6 1.6 0 0 0-1.5 2z"/></svg></button>
      </div>
      <div class="userpill"><span class="av">M</span><b>Matheus</b><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></div>
    </header>

    <div class="scroll" id="view"></div>
  </div>
</div>

<script>
const ICON = {
  os:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6M9 16h4"/></svg>',
  clientes:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9"/><path d="M16 3.1A4 4 0 0 1 16 11"/></svg>',
  pagamentos:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>',
  spark:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"/><path d="M19 15l.7 1.8L21.5 18l-1.8.7L19 21l-.7-1.8L16.5 18l1.8-.7L19 15z"/></svg>',
  go:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>',
  download:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5M12 15V3"/></svg>',
  plus:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>',
