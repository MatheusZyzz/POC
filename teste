/* ---------- chart builders ---------- */
function vbars(bars, idx){
  const W=520,H=230,padL=12,padR=12,padT=30,padB=30;
  const plotW=W-padL-padR, plotH=H-padT-padB;
  const max=Math.max(...bars.map(b=>b.v))*1.18 || 1;
  const n=bars.length, slot=plotW/n, bw=Math.min(slot*0.46,42);
  const gid='bg'+idx;
  let body='';
  bars.forEach((b,i)=>{
    const bh=(b.v/max)*plotH, x=padL+i*slot+(slot-bw)/2, y=padT+(plotH-bh);
    body+=`<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${bw.toFixed(1)}" height="${Math.max(bh,3).toFixed(1)}" rx="6" fill="url(#${gid})"/>`;
    body+=`<text x="${(x+bw/2).toFixed(1)}" y="${(y-9).toFixed(1)}" text-anchor="middle" class="cv">${b.disp||b.v}</text>`;
    body+=`<text x="${(x+bw/2).toFixed(1)}" y="${(padT+plotH+19).toFixed(1)}" text-anchor="middle" class="cx">${b.l}</text>`;
  });
  return `<svg viewBox="0 0 ${W} ${H}" class="chart-svg" role="img" aria-label="Bar chart">
    <defs><linearGradient id="${gid}" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0%" stop-color="#3363FF"/><stop offset="100%" stop-color="#22C9E0"/></linearGradient></defs>
    <line x1="${padL}" y1="${padT+plotH}" x2="${W-padR}" y2="${padT+plotH}" stroke="#E6EAF1"/>
    ${body}</svg>`;
}
function donut(segs){
  const r=58, sw=22, c=2*Math.PI*r, cx=75, cy=75;
  const total=segs.reduce((s,x)=>s+x.v,0)||1;
  let off=0, arcs='';
  segs.forEach(s=>{
    const len=(s.v/total)*c;
    arcs+=`<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${s.color}" stroke-width="${sw}" stroke-dasharray="${len.toFixed(2)} ${(c-len).toFixed(2)}" stroke-dashoffset="${(-off).toFixed(2)}" transform="rotate(-90 ${cx} ${cy})"/>`;
    off+=len;
  });
  return `<svg viewBox="0 0 150 150" class="donut-svg" role="img" aria-label="Donut chart">${arcs}
    <text x="${cx}" y="${cy-2}" text-anchor="middle" class="dn">${total}</text>
    <text x="${cx}" y="${cy+16}" text-anchor="middle" class="dl">total</text></svg>`;
}
function legend(segs){
  const tot=segs.reduce((s,x)=>s+x.v,0)||1;
  return '<div class="legend">'+segs.map(s=>`<div class="li"><span class="sw" style="background:${s.color}"></span><span class="ln">${s.n}</span><span class="lv">${s.v} · ${Math.round(s.v/tot*100)}%</span></div>`).join('')+'</div>';
}
function hbars(items){
  return '<div class="hbars">'+items.map(it=>`<div class="hbar"><span class="hl">${it.l}</span><div class="ht"><div class="hf" style="width:${it.p}%"></div></div><span class="hv">${it.p}%</span></div>`).join('')+'</div>';
}

/* ---------- report renderer ---------- */
function metricCard(m){
  let sub='';
  if(m.s){const ar=m.d?(m.d==='up'?ICON.up:ICON.down):'';const cl=m.d==='up'?'up':(m.d==='down'?'down':'');sub=`<div class="ms ${cl}">${ar}${m.s}</div>`;}
  return `<div class="metric"><div class="ml">${m.l}</div><div class="mv ${m.c}">${m.v}</div>${sub}</div>`;
}
function cell(c){
  if(c===null||c===undefined) return '<td></td>';
  if(Array.isArray(c)) return `<td><span class="badge2 ${c[1]}">${c[0]}</span></td>`;
  if(typeof c==='object'&&'num'in c) return `<td class="num">${c.num}</td>`;
  return `<td>${c}</td>`;
}
function renderReport(id){
  const d=DATA[id];
  const chartHTML = d.chart.kind==='donut'
    ? `<div class="donut-wrap">${donut(d.chart.segs)}${legend(d.chart.segs)}</div>`
    : vbars(d.chart.bars, id.length);
  const rows=d.table.rows.map(r=>'<tr>'+r.map((c,i)=>{
      if(i===0 && !Array.isArray(c) && typeof c!=='object') return `<td class="strong">${c}</td>`;
      return cell(c);
    }).join('')+'</tr>').join('');
  return `
  <div class="report">
    <div class="rhead">
      <div class="ht">
        <h2>${d.title}</h2>
        <div class="meta"><span class="ai">${ICON.spark}Generated by AI</span><span class="dot"></span><span>${d.periodo}</span><span class="dot"></span><span>Framingham branch</span></div>
      </div>
      <div class="ractions">
        <button class="btn" onclick="showHome()">${ICON.plus}New</button>
        <button class="btn primary" onclick="window.print()">${ICON.download}Export PDF</button>
      </div>
    </div>

    <div class="ai-card">
      <span class="badge">${ICON.spark}AI summary</span>
      <p>${d.narrative}</p>
    </div>

    <div class="metrics">${d.metrics.map(metricCard).join('')}</div>

    <div class="grid2">
      <div class="panel"><h3>${d.chart.title}</h3><p class="psub">${d.chart.sub}</p>${chartHTML}</div>
      <div class="panel"><h3>${d.breakdown.title}</h3><p class="psub">${d.breakdown.sub}</p>${hbars(d.breakdown.items)}</div>
    </div>

    <div class="tbl-panel">
      <div class="tbl-head"><h3>${d.table.title}</h3><a>View all ${ICON.arrow}</a></div>
      <table><thead><tr>${d.table.cols.map(c=>`<th>${c}</th>`).join('')}</tr></thead><tbody>${rows}</tbody></table>
    </div>

    <div class="insights">
      <h3>${ICON.bulb}AI recommendations</h3>
      <ul>${d.insights.map(t=>`<li>${ICON.check}<span>${t}</span></li>`).join('')}</ul>
    </div>
  </div>`;
}

