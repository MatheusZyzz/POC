  view.querySelectorAll('.chip,.ex').forEach(n=>n.onclick=()=>generate(n.dataset.type));
  q.focus();
}
function classify(text){
  const t=(text||'').toLowerCase();
  if(/(payment|paid|invoic|collect|billing|outstanding|past[- ]due|overdue invoice|delinqu|cash|\bach\b|\bwire\b|\bcheck\b|credit card)/.test(t)) return 'pagamentos';
  if(/(service order|\bso\b|\bos\b|\border\b|orders|task|deadline|owner|\bjob\b)/.test(t)) return 'os';
  if(/(client|customer|portfolio|segment|churn|lead|revenue)/.test(t)) return 'clientes';
  return null;
}
function doGenerate(text){
  const id=classify(text);
  if(!id){
    const h=document.getElementById('hint');
    if(h){h.textContent='I couldn\u2019t identify the type. Try something like "Service orders", "Clients", or "Payments".';h.classList.add('show');}
    return;
  }
  generate(id);
}
function generate(id){
  view.innerHTML=`<div class="loading"><div class="ring"></div><div class="lt">Generating report…</div><div class="ls">Interpreting your request and querying the data</div></div>`;
  setTimeout(()=>{
    recent=[{id,time:'now'}].concat(recent.filter(r=>r.id!==id));
    openReport(id,false);
  },1150);
}
function openReport(id, instant){
  activeId=id;
  renderRecent();
  view.innerHTML=renderReport(id);
  view.scrollTop=0;
}

